# Copy this file to ".env" and fill in the channels you want.
# Leave a value empty to turn that channel off.
# NEVER commit your real .env file. It is already listed in .gitignore.

# Telegram: create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Discord chat bot (for --bot mode, so you can send it a URL to check).
# A webhook can only send, so replying needs a real bot token:
# discord.com/developers > New Application > Bot > Reset Token.
# Also turn on "Message Content Intent" on that same Bot page.
# The Telegram bot mode reuses TELEGRAM_BOT_TOKEN above.
DISCORD_BOT_TOKEN=
